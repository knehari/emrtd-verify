{
  "expo": {
    "name": "BaynID",
    "slug": "emrtd-verify",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.nehari.baynid",
      "buildNumber": "1",
      "infoPlist": {
        "NFCReaderUsageDescription": "Lecture de la puce du document d'identité (BAC/PACE) pour vérifier son authenticité.",
        "NSCameraUsageDescription": "Capture de la zone lisible du document et du visage du porteur pour la vérification d'identité.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "AuthentikSceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "package": "com.authentik.mobile",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Capture de la zone lisible du document pour la vérification d'identité.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Lecture de la puce du document d'identité (BAC/PACE) pour vérifier son authenticité.",
          "selectIdentifiers": [
            "A0000002471001"
          ],
          "includeNdefEntitlement": false
        }
      ],
      "./plugins/withNfcPaceFormat",
      "./plugins/withPodDeploymentTargetFix",
      "./plugins/withAppDelegateSceneSupport",
      "./plugins/withMetroLanHost",
      "./plugins/withYogaHeaderSearchPaths",
      "./plugins/withCrlTransportSecurity"
    ]
  }
}
