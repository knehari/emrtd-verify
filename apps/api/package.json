{
  "name": "@emrtd-verify/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "NODE_OPTIONS=\"-r ts-node/register/transpile-only\" nest start --watch",
    "dev:worker": "NODE_OPTIONS=\"-r ts-node/register/transpile-only\" node src/worker.ts",
    "start": "node -r ts-node/register/transpile-only dist/main.js",
    "start:worker": "node -r ts-node/register/transpile-only dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "create-kyc-client": "node -r ts-node/register/transpile-only scripts/create-kyc-client.ts",
    "update-kyc-client": "node -r ts-node/register/transpile-only scripts/update-kyc-client.ts",
    "create-admin-user": "node -r ts-node/register/transpile-only scripts/create-admin-user.ts",
    "create-tenant-user": "node -r ts-node/register/transpile-only scripts/create-tenant-user.ts",
    "sync-master-list": "node -r ts-node/register/transpile-only scripts/sync-master-list.ts",
    "import-pkd-ldif": "node -r ts-node/register/transpile-only scripts/import-pkd-ldif.ts",
    "generate-signing-key": "node -r ts-node/register/transpile-only scripts/generate-signing-key.ts",
    "generate-csca-bundle-signing-key": "node -r ts-node/register/transpile-only scripts/generate-csca-bundle-signing-key.ts"
  },
  "dependencies": {
    "@emrtd-verify/emrtd-core": "workspace:*",
    "@emrtd-verify/pki-trust": "workspace:*",
    "@emrtd-verify/shared-types": "workspace:*",
    "@emrtd-verify/verification-policy": "workspace:*",
    "@fastify/compress": "^7.0.3",
    "@fastify/cookie": "^9.4.0",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-fastify": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "4.28.1",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.4.1",
    "otplib": "^13.5.0",
    "pino": "^9.5.0",
    "pino-http": "^9.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/qrcode": "^1.5.6",
    "asn1js": "^3.0.10",
    "pino-pretty": "^11.2.2",
    "pkijs": "^3.4.0",
    "prisma": "^5.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
