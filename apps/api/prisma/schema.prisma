// Schéma Prisma — voir docs/gdpr-compliance.md "Minimisation des données" (article 5.1.c) :
// aucune colonne ne porte de photo, d'embedding facial ou de donnée biométrique brute.
// `VerificationResult` ne contient déjà que des scores/décisions (voir
// packages/shared-types/src/verificationResult.ts), jamais l'image DG2 ni la capture live.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Résultat persisté d'une vérification — le VerificationResult complet est stocké en Json
/// (colonne `result`) pour rester fidèle au contrat KYC (voir docs/kyc-integration.md), les
/// colonnes dénormalisées (verdict, trustChainSource, ...) ne servent qu'à l'indexation/au
/// filtrage sans avoir à parser le Json à chaque requête.
model VerificationRecord {
  id               String   @id @default(uuid())
  verificationId   String   @unique
  /// Client KYC ayant soumis cette vérification (KycClient.clientId) — sert de frontière
  /// d'autorisation pour GET /v1/verifications/:id (un client ne peut lire que ses propres
  /// résultats), pas seulement d'un champ informatif.
  clientId         String
  documentType     String
  issuingCountry   String
  verdict          String
  trustChainSource String
  trustChainLevel  String
  /// VerificationResult complet (packages/shared-types), hors toute image/empreinte biométrique.
  result           Json
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([clientId])
  @@map("verification_records")
}

/// Client autorisé à consommer l'API KYC (voir docs/kyc-integration.md "Authentification").
/// Provisionné hors API (script `scripts/create-kyc-client.ts`), jamais via un endpoint public —
/// l'auto-inscription contredirait le principe même d'une liste de clients autorisés.
model KycClient {
  id                  String   @id @default(uuid())
  /// Identifiant public stable (ex. nom de l'établissement), distinct de la clé API secrète.
  clientId            String   @unique
  /// SHA-256 de la clé API — jamais la clé en clair (voir KycClientService pour le choix de
  /// hachage). La clé elle-même n'est montrée qu'une fois, à la création (voir le script).
  apiKeyHash          String   @unique
  /// Niveaux de confiance PKI ("high"/"medium"/"low") que ce client accepte comme suffisants —
  /// voir docs/pki-trust-model.md. Un document validé à un niveau non accepté par le client
  /// produit un verdict manual_review_required plutôt qu'un faux "authentic".
  acceptedTrustLevels String[]
  /// Champs d'identité que ce client est autorisé à recevoir (principe de minimisation RGPD,
  /// voir docs/gdpr-compliance.md) — filtre appliqué en plus de `requestedFields` par requête.
  allowedFields       String[]
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@map("kyc_clients")
}

/// Journal d'audit append-only (voir docs/gdpr-compliance.md "Sécurité" et AuditService) —
/// jamais de champ d'identité complet ni de donnée biométrique, uniquement la trace qu'une
/// vérification a eu lieu, son verdict et les codes d'anomalie.
model AuditLogEntry {
  id               String   @id @default(uuid())
  verificationId   String
  clientId         String
  verdict          String
  trustChainSource String
  anomalyCodes     String[]
  occurredAt       DateTime

  @@index([verificationId])
  @@index([occurredAt])
  @@map("audit_log_entries")
}

/// État de confiance d'une CSCA persistée — jamais un simple booléen, voir docs/pki-trust-model.md
/// "Modèle de confiance à deux niveaux". Seuls ICAO_ML_VALIDATED, LINK_VALIDATED et
/// OUT_OF_BAND_VALIDATED sont utilisables pour la validation de chaîne (CscaStoreService) ; les
/// autres sont conservés pour audit/revue manuelle mais jamais servis comme ancre de confiance.
/// Nommé CscaCertificateTrustState (et non CscaTrustState) pour ne pas entrer en collision avec
/// le modèle CscaTrustState ci-dessous (le pointeur de lot actif — un concept différent).
enum CscaCertificateTrustState {
  /// Vue dans une donnée PKD (ex. une Master List nationale o=ml,c=XX) mais jamais validée contre
  /// une base de confiance préexistante — jamais servie comme ancre.
  DISCOVERED
  /// Reçue depuis le portail/LDAP ICAO PKD sans validation cryptographique de provenance au-delà
  /// de l'auto-cohérence du CMS — inventaire uniquement, jamais servie comme ancre.
  PKD_OBSERVED
  /// Présente dans la Master List ICAO globale dont le signataire correspond à une ancre épinglée
  /// hors bande (config/master-list-signer-trust-anchors.json) — niveau de confiance le plus fort
  /// obtenu automatiquement.
  ICAO_ML_VALIDATED
  /// Nouvelle CSCA reliée à une CSCA déjà approuvée (rollover par certificat de liaison, ou
  /// signataire d'une Master List nationale relié à une CSCA déjà approuvée pour ce pays).
  LINK_VALIDATED
  /// Confirmée manuellement par une voie hors bande (magasin de confiance étendu, voir
  /// packages/pki-trust/src/trustStore.ts) — jamais automatique.
  OUT_OF_BAND_VALIDATED
  /// Révoquée ou retirée de confiance par décision explicite — jamais servie comme ancre.
  REVOKED_OR_DISTRUSTED
  /// Incohérence détectée (ex. changement non authentifié, algorithme non supporté) — en attente
  /// de revue manuelle, jamais servie comme ancre.
  QUARANTINED
}

/// Un lot de certificats CSCA importés lors d'une synchronisation Master List réussie et
/// vérifiée (voir CscaSyncService et packages/pki-trust/src/masterList.ts). Immutable après
/// création : la bascule atomique (CscaTrustState) est ce qui change, jamais un lot en place —
/// voir docs/pki-trust-model.md "Synchronisation de la Master List".
model CscaSyncBatch {
  id                      String                   @id @default(uuid())
  source                  String // "https" | "ldap"
  masterListSignerSubject String
  certificateCount        Int
  createdAt               DateTime                 @default(now())
  certificates            CscaCertificateRecord[]

  @@index([createdAt])
  @@map("csca_sync_batches")
}

/// Certificats publics uniquement (X.509 CSCA) — aucune donnée personnelle, voir l'en-tête de
/// ce fichier. Chaque certificat appartient à exactement un lot (CscaSyncBatch).
model CscaCertificateRecord {
  id             String        @id @default(uuid())
  batch          CscaSyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId        String
  countryCode    String
  subject        String
  serialNumber   String
  notBefore      DateTime
  notAfter       DateTime
  certificateDer Bytes
  trustState     CscaCertificateTrustState @default(DISCOVERED)
  /// "icao-global-ml" | "country-ml" | "extended-trust-store" | "link-certificate" — provenance
  /// de cet enregistrement, voir CscaSyncService.
  sourceKind     String
  /// Description libre de ce qui a validé ce certificat (ex. "pinned-icao-anchor",
  /// "csca:<numéro de série>") — traçabilité d'audit, jamais utilisé pour une décision.
  validatedVia   String?

  @@index([batchId, countryCode])
  @@index([countryCode, trustState])
  @@map("csca_certificate_records")
}

/// Pointeur vers le lot actuellement actif — table à une seule ligne (id fixe), jamais modifiée
/// sauf par une bascule explicite après succès complet d'une synchronisation. Un échec de
/// synchronisation ne touche jamais cette ligne : le magasin de confiance reste celui du dernier
/// succès (voir docs/pki-trust-model.md "Fiabilité — jamais de trou de confiance").
model CscaTrustState {
  id            Int      @id @default(1)
  activeBatchId String?
  updatedAt     DateTime @updatedAt

  @@map("csca_trust_state")
}

/// Observabilité des exécutions de synchronisation (succès/échec, durée, nombre de certificats) —
/// utile pour l'alerting opérationnel (voir docs/roadmap.md "Observabilité").
model MasterListSyncRun {
  id               String    @id @default(uuid())
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String // "success" | "failed"
  source           String // "https" | "ldap"
  certificateCount Int?
  errorMessage     String?

  @@index([startedAt])
  @@map("master_list_sync_runs")
}
