// Schéma Prisma — voir docs/gdpr-compliance.md "Minimisation des données" (article 5.1.c) :
// aucune colonne ne porte de photo, d'embedding facial ou de donnée biométrique brute.
// `VerificationResult` ne contient déjà que des scores/décisions (voir
// packages/shared-types/src/verificationResult.ts), jamais l'image DG2 ni la capture live.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Résultat persisté d'une vérification — le VerificationResult complet est stocké en Json
/// (colonne `result`) pour rester fidèle au contrat KYC (voir docs/kyc-integration.md), les
/// colonnes dénormalisées (verdict, trustChainSource, ...) ne servent qu'à l'indexation/au
/// filtrage sans avoir à parser le Json à chaque requête.
model VerificationRecord {
  id               String   @id @default(uuid())
  verificationId   String   @unique
  /// Client KYC ayant soumis cette vérification (KycClient.clientId) — sert de frontière
  /// d'autorisation pour GET /v1/verifications/:id (un client ne peut lire que ses propres
  /// résultats), pas seulement d'un champ informatif.
  clientId         String
  documentType     String
  issuingCountry   String
  verdict          String
  trustChainSource String
  trustChainLevel  String
  /// VerificationResult complet (packages/shared-types), hors toute image/empreinte biométrique.
  result           Json
  createdAt        DateTime @default(now())
  /// Fiche "personne vérifiée" consolidée à laquelle cette tentative se rattache (voir
  /// VerifiedPerson et VerifiedPersonService) — nullable : purgée avec SetNull si la fiche
  /// elle-même est supprimée, jamais l'inverse (la purge de rétention ne doit jamais échouer
  /// à cause de cette relation, voir RetentionSchedulerService).
  verifiedPerson   VerifiedPerson? @relation(fields: [verifiedPersonId], references: [id], onDelete: SetNull)
  verifiedPersonId String?
  /// Revue humaine formelle de ce cas, si elle a eu lieu — voir VerificationReview.
  review           VerificationReview?

  @@index([createdAt])
  @@index([clientId])
  @@index([verifiedPersonId])
  @@map("verification_records")
}

/// Décision d'un opérateur humain clôturant un cas — pas de valeur "en attente" : l'absence
/// de VerificationReview EST l'état "pas encore revu" (voir VerificationRecord.review, nullable).
enum VerificationReviewOutcome {
  CONFIRMED_AUTHENTIC
  CONFIRMED_REJECTED
  ESCALATED
}

/// Trace formelle de la revue humaine d'une vérification "manual_review_required" — distincte
/// du verdict automatisé (VerificationRecord.verdict) et du changement de statut VerifiedPerson
/// (watchlistReason, texte libre sans acteur identifié). Un seul enregistrement par
/// VerificationRecord (contrainte unique via verificationRecordId) : c'est la décision qui clôt
/// le cas, pas un flux de commentaires. Condition pour ETSI TS 119 461 (niveau "Extended") et
/// pour la validation humaine obligatoire du référentiel PVID — voir docs/pvid-compliance.md.
/// Le reviewer est toujours un AdminUser (jamais un TenantUser) : la revue manuelle est réalisée
/// par l'opérateur interne de la plateforme (SUPPORT ou SUPER_ADMIN, voir AdminRole), pas par le
/// client KYC lui-même — cohérent avec la conception déjà documentée d'AdminRole.
model VerificationReview {
  id                    String                    @id @default(uuid())
  verificationRecord    VerificationRecord        @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)
  verificationRecordId  String                    @unique
  reviewer              AdminUser                 @relation(fields: [reviewerId], references: [id])
  reviewerId            String
  outcome               VerificationReviewOutcome
  reason                String
  reviewedAt            DateTime                  @default(now())

  @@index([reviewerId])
  @@map("verification_reviews")
}

/// Client autorisé à consommer l'API KYC (voir docs/kyc-integration.md "Authentification").
/// Provisionné hors API (script `scripts/create-kyc-client.ts`), jamais via un endpoint public —
/// l'auto-inscription contredirait le principe même d'une liste de clients autorisés.
model KycClient {
  id                  String   @id @default(uuid())
  /// Identifiant public stable (ex. nom de l'établissement), distinct de la clé API secrète.
  clientId            String   @unique
  /// SHA-256 de la clé API — jamais la clé en clair (voir KycClientService pour le choix de
  /// hachage). La clé elle-même n'est montrée qu'une fois, à la création (voir le script).
  apiKeyHash          String   @unique
  /// Niveaux de confiance PKI ("high"/"medium"/"low") que ce client accepte comme suffisants —
  /// voir docs/pki-trust-model.md. Un document validé à un niveau non accepté par le client
  /// produit un verdict manual_review_required plutôt qu'un faux "authentic".
  acceptedTrustLevels String[]
  /// Champs d'identité que ce client est autorisé à recevoir (principe de minimisation RGPD,
  /// voir docs/gdpr-compliance.md) — filtre appliqué en plus de `requestedFields` par requête.
  allowedFields       String[]
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  /// Comptes humains du portail tenant scopés à ce client (voir TenantUser) — distincts de
  /// `apiKeyHash` (identifiant machine-à-machine).
  tenantUsers         TenantUser[]
  /// Fiches "personnes vérifiées" consolidées pour ce tenant (voir VerifiedPerson).
  verifiedPersons     VerifiedPerson[]

  @@map("kyc_clients")
}

/// Journal d'audit append-only (voir docs/gdpr-compliance.md "Sécurité" et AuditService) —
/// jamais de champ d'identité complet ni de donnée biométrique, uniquement la trace qu'une
/// vérification a eu lieu, son verdict et les codes d'anomalie.
model AuditLogEntry {
  id               String   @id @default(uuid())
  verificationId   String
  clientId         String
  verdict          String
  trustChainSource String
  anomalyCodes     String[]
  occurredAt       DateTime

  @@index([verificationId])
  @@index([occurredAt])
  @@map("audit_log_entries")
}

/// État de confiance d'une CSCA persistée — jamais un simple booléen, voir docs/pki-trust-model.md
/// "Modèle de confiance à deux niveaux". Seuls ICAO_ML_VALIDATED, LINK_VALIDATED et
/// OUT_OF_BAND_VALIDATED sont utilisables pour la validation de chaîne (CscaStoreService) ; les
/// autres sont conservés pour audit/revue manuelle mais jamais servis comme ancre de confiance.
/// Nommé CscaCertificateTrustState (et non CscaTrustState) pour ne pas entrer en collision avec
/// le modèle CscaTrustState ci-dessous (le pointeur de lot actif — un concept différent).
enum CscaCertificateTrustState {
  /// Vue dans une donnée PKD (ex. une Master List nationale o=ml,c=XX) mais jamais validée contre
  /// une base de confiance préexistante — jamais servie comme ancre.
  DISCOVERED
  /// Reçue depuis le portail/LDAP ICAO PKD sans validation cryptographique de provenance au-delà
  /// de l'auto-cohérence du CMS — inventaire uniquement, jamais servie comme ancre.
  PKD_OBSERVED
  /// Présente dans la Master List ICAO globale dont le signataire correspond à une ancre épinglée
  /// hors bande (config/master-list-signer-trust-anchors.json) — niveau de confiance le plus fort
  /// obtenu automatiquement.
  ICAO_ML_VALIDATED
  /// Nouvelle CSCA reliée à une CSCA déjà approuvée (rollover par certificat de liaison, ou
  /// signataire d'une Master List nationale relié à une CSCA déjà approuvée pour ce pays).
  LINK_VALIDATED
  /// Confirmée manuellement par une voie hors bande (magasin de confiance étendu, voir
  /// packages/pki-trust/src/trustStore.ts) — jamais automatique.
  OUT_OF_BAND_VALIDATED
  /// Révoquée ou retirée de confiance par décision explicite — jamais servie comme ancre.
  REVOKED_OR_DISTRUSTED
  /// Incohérence détectée (ex. changement non authentifié, algorithme non supporté) — en attente
  /// de revue manuelle, jamais servie comme ancre.
  QUARANTINED
}

/// Un lot de certificats CSCA importés lors d'une synchronisation Master List réussie et
/// vérifiée (voir CscaSyncService et packages/pki-trust/src/masterList.ts). Immutable après
/// création : la bascule atomique (CscaTrustState) est ce qui change, jamais un lot en place —
/// voir docs/pki-trust-model.md "Synchronisation de la Master List".
model CscaSyncBatch {
  id                      String                   @id @default(uuid())
  source                  String // "https" | "ldap"
  masterListSignerSubject String
  certificateCount        Int
  createdAt               DateTime                 @default(now())
  certificates            CscaCertificateRecord[]

  @@index([createdAt])
  @@map("csca_sync_batches")
}

/// Certificats publics uniquement (X.509 CSCA) — aucune donnée personnelle, voir l'en-tête de
/// ce fichier. Chaque certificat appartient à exactement un lot (CscaSyncBatch).
model CscaCertificateRecord {
  id             String        @id @default(uuid())
  batch          CscaSyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId        String
  countryCode    String
  subject        String
  serialNumber   String
  notBefore      DateTime
  notAfter       DateTime
  certificateDer Bytes
  trustState     CscaCertificateTrustState @default(DISCOVERED)
  /// "icao-global-ml" | "country-ml" | "extended-trust-store" | "link-certificate" — provenance
  /// de cet enregistrement, voir CscaSyncService.
  sourceKind     String
  /// Description libre de ce qui a validé ce certificat (ex. "pinned-icao-anchor",
  /// "csca:<numéro de série>") — traçabilité d'audit, jamais utilisé pour une décision.
  validatedVia   String?

  @@index([batchId, countryCode])
  @@index([countryCode, trustState])
  @@map("csca_certificate_records")
}

/// Pointeur vers le lot actuellement actif — table à une seule ligne (id fixe), jamais modifiée
/// sauf par une bascule explicite après succès complet d'une synchronisation. Un échec de
/// synchronisation ne touche jamais cette ligne : le magasin de confiance reste celui du dernier
/// succès (voir docs/pki-trust-model.md "Fiabilité — jamais de trou de confiance").
model CscaTrustState {
  id            Int      @id @default(1)
  activeBatchId String?
  updatedAt     DateTime @updatedAt

  @@map("csca_trust_state")
}

/// Observabilité des exécutions de synchronisation (succès/échec, durée, nombre de certificats) —
/// utile pour l'alerting opérationnel (voir docs/roadmap.md "Observabilité").
model MasterListSyncRun {
  id               String    @id @default(uuid())
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String // "success" | "failed"
  source           String // "https" | "ldap"
  certificateCount Int?
  errorMessage     String?

  @@index([startedAt])
  @@map("master_list_sync_runs")
}

/// Rôle d'un compte administrateur interne SaaS (voir AdminAuthModule) — SUPPORT peut consulter
/// et faire de la revue manuelle, seul SUPER_ADMIN peut créer/suspendre un tenant (KycClient) ou
/// un autre AdminUser (voir docs/admin-web.md).
enum AdminRole {
  SUPER_ADMIN
  SUPPORT
}

/// Compte humain d'un administrateur interne SaaS (apps/admin-web) — distinct de KycClient
/// (identifiant machine-à-machine d'un tenant) et de TenantUser (compte humain d'un tenant).
/// Provisionné hors API (script `scripts/create-admin-user.ts`), jamais par auto-inscription —
/// même principe que KycClient (voir docs/kyc-integration.md "Authentification").
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  /// scrypt (node:crypto, voir PasswordHasher) — pas de dépendance native (argon2/bcrypt),
  /// cohérent avec le reste du projet (KycClientService.hashApiKey, ResultSignerService).
  passwordHash String
  role         AdminRole @default(SUPPORT)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  /// Secret TOTP (RFC 6238, voir common/security/totp.ts) — présent dès le premier appel à
  /// /admin/auth/2fa/setup, mais n'entre en vigueur qu'une fois `totpEnabled` passé à true (code
  /// confirmé) : un setup abandonné laisse un secret orphelin inoffensif, jamais utilisé tant que
  /// totpEnabled reste false.
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  /// Revues manuelles réalisées par cet administrateur — voir VerificationReview.
  reviews      VerificationReview[]

  @@map("admin_users")
}

/// Rôle d'un compte humain au sein d'un tenant (portail apps/tenant-portal).
enum TenantUserRole {
  OWNER
  MEMBER
}

/// Compte humain permettant à un tenant (KycClient) de se connecter au portail tenant — distinct
/// de `KycClient.apiKeyHash` (identifiant machine-à-machine de l'intégration API). Provisionné
/// par un administrateur interne (voir docs/admin-web.md) : pas d'auto-inscription tenant, la
/// création d'un tenant reste une décision commerciale/sécurité humaine.
model TenantUser {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  /// Référence `KycClient.clientId` (l'identifiant PUBLIC stable, ex. "acme-bank"), pas l'id
  /// interne — même convention que `VerificationRecord.clientId`, pour que le worker BullMQ
  /// (qui ne connaît que ce clientId public via le job) n'ait jamais besoin d'une requête
  /// supplémentaire pour résoudre l'id interne avant de relier un VerifiedPerson.
  kycClient    KycClient      @relation(fields: [kycClientId], references: [clientId], onDelete: Cascade)
  kycClientId  String
  role         TenantUserRole @default(MEMBER)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  /// Secret TOTP — même principe que AdminUser.totpSecret ci-dessus.
  totpSecret   String?
  totpEnabled  Boolean        @default(false)

  @@index([kycClientId])
  @@map("tenant_users")
}

/// Statut consolidé d'une personne au regard d'un tenant donné (voir VerifiedPerson).
/// WATCHLIST est toujours une action humaine explicite (jamais automatique) — voir
/// VerifiedPersonService.
enum VerifiedPersonStatus {
  VERIFIED
  UNVERIFIED
  PENDING_REVIEW
  WATCHLIST
}

/// Vue consolidée d'une personne au travers de plusieurs tentatives de vérification pour un même
/// tenant (voir VerifiedPersonService et docs/gdpr-compliance.md "VerifiedPerson"). Rapprochement
/// par clé naturelle hachée (documentType+issuingCountry+documentNumber+dateOfBirth normalisés,
/// jamais stockée en clair — voir VerifiedPersonService.computeMatchKey) : limite assumée, un
/// renouvellement de document (nouveau documentNumber) crée une nouvelle fiche plutôt que de
/// rattacher à l'ancienne (voir docs/roadmap.md). Les champs dénormalisés (status/displayFields/
/// lastVerifiedAt/verificationCount) sont mis à jour par VerifiedPersonService à chaque nouvelle
/// vérification liée, jamais recalculés à la volée à partir de `verifications` — pages de liste
/// du portail tenant rapides sans agrégation SQL à chaque requête.
model VerifiedPerson {
  id                String               @id @default(uuid())
  /// Référence `KycClient.clientId` (identifiant public), même convention que TenantUser
  /// ci-dessus et que `VerificationRecord.clientId`.
  kycClient         KycClient            @relation(fields: [kycClientId], references: [clientId], onDelete: Cascade)
  kycClientId       String
  matchKey          String
  status            VerifiedPersonStatus @default(PENDING_REVIEW)
  documentType      String
  issuingCountry    String
  /// Sous-ensemble de VerificationResult.document.fields déjà filtré par `KycClient.allowedFields`
  /// (jamais plus que ce que GET /v1/verifications/:id renverrait déjà à ce tenant) — dénormalisé
  /// pour affichage rapide dans le portail tenant.
  displayFields     Json
  /// Renseigné uniquement quand `status = WATCHLIST`, saisi par un humain (tenant ou admin) —
  /// jamais déduit automatiquement d'un verdict.
  watchlistReason   String?
  firstVerifiedAt   DateTime             @default(now())
  lastVerifiedAt    DateTime             @default(now())
  verificationCount Int                  @default(0)
  verifications     VerificationRecord[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  /// Non nul une fois anonymisée par VerifiedPersonRetentionScheduler (voir
  /// docs/gdpr-compliance.md "Rétention" et docs/tenant-portal.md) — `displayFields` est alors
  /// vidé, `status`/`matchKey`/compteurs conservés pour les statistiques agrégées. Jamais pour un
  /// statut WATCHLIST (décision humaine sticky, voir VerifiedPersonService). Opt-in : n'a jamais
  /// lieu tant que `VERIFIED_PERSON_RETENTION_DAYS` n'est pas configuré — aucune politique par
  /// défaut sans AIPD/DPIA couvrant explicitement cette rétention.
  anonymizedAt      DateTime?

  @@unique([kycClientId, matchKey])
  @@index([kycClientId, status])
  @@map("verified_persons")
}
