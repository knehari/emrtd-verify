# API
NODE_ENV=development
API_PORT=3000
API_JWT_SECRET=change-me

# Worker BullMQ (processus séparé de l'API HTTP, voir apps/api/src/worker.ts et
# docs/roadmap.md Phase 6 "processus séparé") — port du petit listener HTTP exposant
# les métriques Prometheus propres à ce processus (GET /metrics).
WORKER_METRICS_PORT=3001

# Base de données
DATABASE_URL=postgresql://emrtd:emrtd@localhost:5432/emrtd_verify
# Identifiants du conteneur postgres de docker-compose.yml — DOIVENT rester cohérents avec
# DATABASE_URL ci-dessus. Valeurs de développement par défaut ; changer avant tout déploiement
# au-delà d'un poste local (voir docker-compose.yml, port lié à 127.0.0.1 uniquement).
POSTGRES_USER=emrtd
POSTGRES_PASSWORD=emrtd

# Cache / files d'attente
REDIS_URL=redis://localhost:6379

# Service de reconnaissance faciale (interne)
FACE_MATCH_URL=http://localhost:8001
FACE_MATCH_API_KEY=change-me

# Synchronisation de la CSCA Master List ICAO PKD — voir docs/pki-trust-model.md et
# packages/pki-trust/src/{masterList,pkdClient}.ts. Deux sources possibles ; PKD_MASTER_LIST_SOURCE
# choisit laquelle est utilisée (défaut "https").
PKD_MASTER_LIST_SOURCE=https

# Source HTTPS — nombreux opérateurs (PKD nationales, miroirs) exposent la Master List et les CRL
# par HTTPS ; c'est la voie la plus simple sans accès LDAP direct à l'ICAO PKD.
PKD_MASTER_LIST_HTTPS_URL=
# "{countryCode}" est interpolé, ex. https://pkd-mirror.example.org/crl/{countryCode}.crl
PKD_CRL_HTTPS_URL_TEMPLATE=

# Source LDAP — annuaire officiel ICAO PKD. L'URL ci-dessous est illustrative (un nom d'hôte
# plausible pour un point d'accès PKD ICAO) et n'a PAS été vérifiée comme joignable : un accès
# réel nécessite un enregistrement ICAO PKD (identifiants fournis à l'inscription). Base DN/filtre/
# attribut sont volontairement laissés vides plutôt que supposés : ils dépendent de l'accès accordé
# — voir packages/pki-trust/src/pkdClient.ts.
ICAO_PKD_LDAP_URL=ldap://pkddownloadsg.icao.int:389
ICAO_PKD_LDAP_BIND_DN=
ICAO_PKD_LDAP_BIND_PASSWORD=
PKD_LDAP_MASTER_LIST_BASE_DN=
PKD_LDAP_MASTER_LIST_FILTER=
PKD_LDAP_MASTER_LIST_ATTRIBUTE=CscaMasterListData
PKD_LDAP_CRL_BASE_DN=
PKD_LDAP_CRL_FILTER=
PKD_LDAP_CRL_ATTRIBUTE=

# Ancres de confiance pour vérifier l'authenticité de la Master List elle-même (certificat du
# "Master List Signer", obtenu hors bande — voir config/master-list-signer-trust-anchors.README.md).
# Ne jamais alimenter automatiquement.
MASTER_LIST_SIGNER_TRUST_ANCHORS_PATH=./config/master-list-signer-trust-anchors.json

# Nombre de lots CSCA conservés en base après une synchronisation réussie (le lot actif + un
# court historique pour audit/rollback manuel) — voir CscaSyncService.
CSCA_SYNC_RETAIN_BATCHES=2

# Magasin de confiance étendu (pays hors PKD) — nécessite une revue manuelle, voir docs/pki-trust-model.md
EXTENDED_TRUST_STORE_PATH=./config/extended-trust-store.json

# Durée de mise en cache (ms) des ancres CSCA ICAO PKD par pays, optionnel (défaut 1h) — voir
# apps/api/src/modules/pki/trust-cache.service.ts
TRUST_CACHE_TTL_MS=3600000

# KYC — clients tiers autorisés à consommer l'API
KYC_WEBHOOK_SIGNING_SECRET=change-me

# Rétention des données (jours) — voir docs/gdpr-compliance.md
DATA_RETENTION_DAYS=30

# Anonymisation dédiée à VerifiedPerson (voir docs/gdpr-compliance.md "Rétention" et
# docs/tenant-portal.md) — DÉLIBÉRÉMENT laissé vide par défaut : contrairement à
# DATA_RETENTION_DAYS, aucune valeur par défaut n'est fournie ici. VerifiedPerson est conçu pour
# survivre à DATA_RETENTION_DAYS (utilité "à surveiller" dans la durée) ; choisir une période de
# rétention est une décision de politique qui doit être déterminée par une AIPD/DPIA complète
# avant production, pas supposée par cette plateforme. Tant que cette variable n'est pas
# renseignée, VerifiedPersonRetentionScheduler ne fait rien.
VERIFIED_PERSON_RETENTION_DAYS=

# Signature cryptographique des VerificationResult (ECDSA P-256) — permet au client KYC de
# détecter une altération du résultat en transit/stockage, voir docs/kyc-integration.md
# "Vérification de la signature" et apps/api/src/modules/verification/result-signer.service.ts.
# Générer une paire avec : pnpm --filter @emrtd-verify/api generate-signing-key
# AVERTISSEMENT PRODUCTION : une variable d'environnement en clair est SUFFISANTE pour développer/
# tester ce mécanisme, mais PAS pour la production — un déploiement réel doit détenir cette clé
# privée dans un HSM/KMS (voir docs/roadmap.md Phase 5). Sans clé configurée, les résultats sont
# émis avec une signature vide plutôt que de faire échouer la vérification.
VERIFICATION_RESULT_SIGNING_PRIVATE_KEY=
VERIFICATION_RESULT_SIGNING_PUBLIC_KEY=

# Interface d'administration interne (apps/admin-web) — voir docs/admin-web.md. Secret de
# signature des jetons de session (cookie httpOnly `admin_session`), distinct de TENANT_JWT_SECRET
# ci-dessous : générer une valeur aléatoire à haute entropie, ex. `openssl rand -hex 32`.
# Provisionner le premier compte avec : pnpm --filter @emrtd-verify/api create-admin-user
ADMIN_JWT_SECRET=change-me
# Origine (schéma+hôte+port) d'où apps/admin-web sert ses requêtes — nécessaire pour autoriser le
# cookie de session en cross-origin (voir main.ts "CORS").
ADMIN_WEB_ORIGIN=http://localhost:4000

# Portail tenant (apps/tenant-portal) — voir docs/tenant-portal.md. Comptes provisionnés par un
# administrateur : pnpm --filter @emrtd-verify/api create-tenant-user
TENANT_JWT_SECRET=change-me
TENANT_PORTAL_ORIGIN=http://localhost:4001

# Registre de statut de documents perdus/volés (bonne pratique ENISA, voir docs/pvid-compliance.md)
# — DÉLIBÉRÉMENT laissé vide par défaut : accéder à un registre réel (ex. INTERPOL SLTD) nécessite
# un enregistrement/accord spécifique, pas seulement une URL. Tant que cette variable n'est pas
# renseignée, DocumentStatusService.checkStatus retourne toujours checked:false (jamais interprété
# comme "non signalé" — voir AnomalyDetectionService.LOST_STOLEN_STATUS_NOT_CHECKED).
# "{issuingState}" et "{documentNumber}" sont interpolés dans l'URL ; le contrat exact (réponse
# JSON { "reported": boolean }, authentification Bearer) est générique et non vérifié contre un
# registre réel — voir apps/api/src/modules/document-status/lost-stolen-registry.ts.
LOST_STOLEN_REGISTRY_URL_TEMPLATE=
LOST_STOLEN_REGISTRY_API_KEY=

# Dashboard Grafana (voir docs/admin-web.md "Dashboard Grafana") — provisionné dans
# docker-compose.yml (datasource Prometheus + dashboard JSON versionnés dans config/grafana/),
# accessible sur http://localhost:3002 par défaut. Changer ce mot de passe avant tout déploiement
# au-delà d'un poste de développement local.
GRAFANA_ADMIN_PASSWORD=change-me
